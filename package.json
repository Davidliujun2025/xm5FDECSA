{
  "name": "bot-rag",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RAG chatbot backend and frontend workspace",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "start": "npm run start --workspace backend",
    "test": "node --test \"tests/**/*.test.js\"",
    "build": "npm run build --workspace frontend",
    "security-scan": "node scripts/security-scan.js",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify.ps1"
  },
  "devDependencies": {
    "supertest": "7.1.4"
  }
}
