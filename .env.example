NODE_ENV=development
APP_VERSION=0.1.0
RUN_PROFILE=local
RAG_HOST=127.0.0.1
RAG_PORT=3000
RAG_API_KEY=
FRONTEND_SESSION_SECRET=
FRONTEND_SESSION_TTL_SECONDS=3600
# local FAQ 模式可留空；team 模式必须填写
FRONTEND_DEFAULT_TOPIC_ID=
FRONTEND_DIST_DIR=./frontend/dist
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:3000
# 仅当应用只监听 127.0.0.1 且由本机反向代理设置 X-Real-IP 时启用
TRUST_LOOPBACK_PROXY=false
TEAM_ALLOWED_CIDRS=
DATA_DIR=./data
MAX_FILE_MB=30
MAX_TOTAL_FILES=500
MAX_TOTAL_STORAGE_GB=5
MAX_TOTAL_CHUNKS=50000
MAX_CONCURRENT_REQUESTS=3

MODEL_BASE_URL=
MODEL_API_KEY=
EMBEDDING_MODEL=
CHAT_MODEL=

# DeepSeek 仅用于 FAQ 意图识别，不作为 Embedding 模型
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
FIXED_REFUSAL_TEXT=抱歉，目前我没能理解您的问题，请您用文字清晰描述具体需求，或者您可回复您想要咨询的问题对应的数字。我可以为您解答：\n1、PMP®课程内容、面授/远程班选择\n2、报考条件、考试报名流程\n3、培训费用、教材及学习平台\n4、证书续证与PDU积累
HUMAN_TRANSFER_TEXT=您咨询的问题需要专业顾问为您详细解答，已为您转接人工服务通道。\n请您通过以下方式联系我们：\n📞 服务热线：400-638-0878（24小时咨询）\n💬 在线客服：点击页面右侧“在线交谈”按钮，与人工客服实时沟通\n📱 QQ咨询：王老师 1851140832 | 于老师 153762324 | 刘老师 780578332
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_TOTAL_TIMEOUT_SECONDS=30

CHUNK_TARGET_CHARS=1000
CHUNK_OVERLAP_CHARS=150
RETRIEVAL_CANDIDATES=10
ANSWER_CONTEXT_LIMIT=5
EVIDENCE_THRESHOLD=0.45
RELATED_EVIDENCE_THRESHOLD=0.25
CHAT_SESSION_TIMEOUT_MINUTES=15
CHAT_HISTORY_TURNS=1
FAQ_MATCH_THRESHOLD=0.78
FAQ_RELATED_THRESHOLD=0.25
FAQ_MAX_CANDIDATES=5
